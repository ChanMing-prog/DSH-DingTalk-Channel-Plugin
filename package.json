{
  "name": "@local/dsh-channel-dingtalk",
  "version": "0.3.0",
  "description": "DeepSeek Harness 的钉钉 Channel 插件。把钉钉官方 OpenClaw Connector 剥离 OpenClaw 依赖、重写为 DSH 原生插件。",
  "type": "module",
  "main": "./dist/apply.js",
  "exports": {
    ".": "./dist/apply.js",
    "./tools": "./dist/tools/index.js",
    "./settings-schema": "./dist/settings-schema.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist/",
    "src/",
    "cordis.yml",
    "settings-schema.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dingtalk",
    "dingtalk-bot",
    "channel",
    "ai-card",
    "streaming",
    "钉钉",
    "钉钉机器人"
  ],
  "author": "ChanMing-prog",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChanMing-prog/DSH-DingTalk-Channel-Plugin.git"
  },
  "bugs": {
    "url": "https://github.com/ChanMing-prog/DSH-DingTalk-Channel-Plugin/issues"
  },
  "homepage": "https://github.com/ChanMing-prog/DSH-DingTalk-Channel-Plugin#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs-local": ">=0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": { "optional": true }
  },
  "dependencies": {
    "axios": "1.14.0",
    "dingtalk-stream": "2.1.4",
    "form-data": "4.0.0",
    "qrcode-terminal": "0.12.0",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "mammoth": "^1.8.0",
    "fluent-ffmpeg": "^2.1.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "axios-mock-adapter": "^1.22.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}